NEXT_PUBLIC_SITE_URL=https://zhiyincareer.com
# Browser requests stay same-origin; Next.js forwards them to the backend below.
NEXT_PUBLIC_API_BASE_URL=/backend
BACKEND_API_URL=http://127.0.0.1:4400
NEXT_PUBLIC_FF_V4_TODAY=true
NEXT_PUBLIC_FF_INTERVIEW_WORKSPACE=true
NEXT_PUBLIC_FF_AI_CAREER_AGENTS=true
NEXT_PUBLIC_FF_MEMBERSHIP=true
NEXT_PUBLIC_V4_ROLLOUT_PERCENTAGE=5
# Payment remains disabled until WeChat qualification is confirmed.
WECHAT_PAYMENT_ENABLED=false
# Add monitoring credentials only in the deployment secret manager.
ERROR_MONITOR_DSN=
